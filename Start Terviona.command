#!/bin/bash
# ============================================================
#  TERVIONA — запуск сайта одним кликом (macOS)
#  Двойной клик по этому файлу: сервер стартует и сайт
#  открывается в браузере автоматически.
# ============================================================
cd "$(dirname "$0")" || exit 1

PORT=8765
URL="http://localhost:$PORT/"

# Если сервер уже запущен — просто открываем сайт.
if curl -s -o /dev/null --max-time 1 "$URL"; then
  open "$URL"
  exit 0
fi

# Открыть браузер через секунду (сервер поднимается мгновенно).
( sleep 1 && open "$URL" ) &

echo "──────────────────────────────────────────────"
echo "  TERVIONA · mouse & audio database"
echo "  $URL"
echo "  Остановить: закрыть это окно (⌘W) или Ctrl+C"
echo "──────────────────────────────────────────────"
python3 local_server.py --port "$PORT"
